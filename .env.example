# Every variable is optional. With all of them unset the app runs in local mode
# (localStorage, browser speech, default instructions, no agents) and routes answer `persisted: false`.

# Aiven PostgreSQL: sessions, passports, instruction versions, operator profiles, agent proposals.
# Local: postgres://spatialforge:spatialforge@localhost:55432/spatialforge
DATABASE_URL=
# Aiven ClickHouse HTTPS endpoint (https://host:port): every spatial event; the Critic's query tools read it.
# Local: http://localhost:58123 with user/password spatialforge
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Aiven Valkey (rediss://...): live session state, Critic job queue, Coach cache, LLM rate limits.
# Local: redis://localhost:56379
VALKEY_URL=
# Aiven project CA: PEM contents (literal \n allowed) or a path to ca.pem. Enables verified TLS for all three services.
AIVEN_CA_CERT=
# Shared secret for admin actions (Run critic, Approve/Reject). Demo-grade: no per-user accounts.
ADMIN_TOKEN=
# Critic and Coach agents (pinned model z-ai/glm-5.3-flash). Unset: deterministic rule-based agents.
OPENROUTER_API_KEY=
# Optional neural voice; unset: browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
