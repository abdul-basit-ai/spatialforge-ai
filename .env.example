# Data services (Aiven in production, docker-compose locally). Leave unset to run in local-only mode.
# Local: postgres://spatialforge:spatialforge@localhost:55432/spatialforge
DATABASE_URL=
# Local: http://localhost:58123  (Aiven: the https:// ClickHouse HTTPS endpoint)
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Local: redis://localhost:56379  (Aiven: rediss://...)
VALKEY_URL=
# Aiven project CA: PEM contents or a path to ca.pem. Enables verified TLS for PostgreSQL (verify-full), ClickHouse, and Valkey.
AIVEN_CA_CERT=
ADMIN_TOKEN=
ADMIN_EMAIL=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
N8N_DEMO_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
NEXT_PUBLIC_8THWALL_ENGINE_URL=https://cdn.jsdelivr.net/npm/@8thwall/engine-binary@1/dist/xr.js
